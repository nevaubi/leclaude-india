# ---- OpenAI (required for every AI feature) -------------------------------
OPENAI_API_KEY=sk-...
# Primary reasoning model used by the office agents, search agent, e-discovery analysis and workflows.
OPENAI_MODEL=gpt-5.4
# Fast/cheap model used for classification, summaries, autocomplete and background indexing.
OPENAI_FAST_MODEL=gpt-5.4-mini
# Embedding model for semantic search / indexing.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Image model used by the "insert image" office tool.
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Optional: reasoning effort for the primary model (none|minimal|low|medium|high|xhigh)
OPENAI_REASONING_EFFORT=medium
# Optional: custom base URL (Azure / proxy). Leave empty for api.openai.com
OPENAI_BASE_URL=

# ---- Legal research providers (all optional; public endpoints work without keys) ----
COURTLISTENER_API_TOKEN=
GOVINFO_API_KEY=DEMO_KEY

# ---- Storage -----------------------------------------------------------------
# SQLite database + uploaded files live here (defaults to ./data)
LECLAUDE_DATA_DIR=./data

# ---- Current user (demo persona; must be a seeded person id) --------------------
# Overrides the signed-in identity everywhere (Home, Settings, Library, workflows). Defaults to p_jwhitfield.
LECLAUDE_USER_ID=p_jwhitfield

# ---- Firm identity (shown in the shell) -----------------------------------------
NEXT_PUBLIC_FIRM_NAME=Mehra & Rao Advocates
NEXT_PUBLIC_APP_NAME=Pramana

# ---- Intelligence layer (background ingestion) ------------------------------
# Optional provider keys. Public endpoints (CourtListener anonymous, eCFR, Federal Register, GovInfo DEMO_KEY, openFDA) work without keys.
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
OPENFDA_API_KEY=
# Comma-separated folders the "Local document folders" source indexes (PDF, Word, Excel, text, Markdown, HTML, CSV, JSON).
LECLAUDE_CORPUS_DIRS=
# Background runner: inline (default; in-process loop started by src/instrumentation.ts), cron (Vercel: vercel.json calls
# POST /api/intel/jobs/tick every 10 minutes — Hobby plans allow one cron run per day, so use an external cron such as
# cron-job.org hitting the same route), or off.
LECLAUDE_BACKGROUND=inline
# When set, /api/intel/jobs/tick requires "Authorization: Bearer <CRON_SECRET>" (Vercel sends it automatically).
CRON_SECRET=
# Set to 1 to block all outbound provider requests (tests, air-gapped demos).
INTEL_OFFLINE=

# ---- Authentication / authorization (src/lib/auth) -------------------------------
# dev (default): the demo persona above, mapped to a principal with its seeded role and tenant-wide matter access.
# header: a reverse proxy that authenticated upstream asserts the user as JSON (or base64url JSON) in the
#         x-leclaude-user header: {"id","name","tenantId","roles":[...],"matterIds":[...]|"*"}. Trusted only with
#         AUTH_TRUST_HEADER=true. jwt: "Authorization: Bearer <token>" verified with HS256 (AUTH_JWT_SECRET) or
#         RS256 (AUTH_JWT_PUBLIC_KEY, PEM; \n escapes allowed); exp/nbf always, iss/aud when set. Claims: sub, name,
#         email, tenant, roles, matters. Unknown modes fail closed. In jwt mode the /login session cookie (signed
#         with AUTH_JWT_SECRET, 32+ chars) is accepted too and src/middleware.ts requires sign-in on every page and
#         API route. Rollout order: docs/architecture/auth.md.
AUTH_MODE=dev
AUTH_TRUST_HEADER=
AUTH_JWT_SECRET=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
# One-time owner password bootstrap at /login (inert once any account has a password; remove after rollout).
AUTH_SETUP_TOKEN=
# Session cookies are Secure when NODE_ENV=production; set false only for a plain-HTTP test host.
AUTH_COOKIE_SECURE=
# Tenant id stamped on principals and audit events (single-tenant deployments keep the default).
LECLAUDE_TENANT_ID=mehra-rao
# Set to 1 to also audit allowed plain reads (denials, writes, exports and privileged reads are always audited).
AUTH_AUDIT_READS=
# CRON_SECRET (above) doubles as the service principal token: "Authorization: Bearer <CRON_SECRET>" resolves to a
# service principal in every auth mode, so scheduled drivers keep working behind real authentication.

# ---- Model runtime (multi-provider) ---------------------------------------------
# Preferred provider for every role when more than one is configured: bedrock | anthropic | openai | openrouter.
# Default order is Bedrock → Anthropic → OpenAI (the constitution's AWS-first direction); routing is capability-aware, so a
# request that needs server web search never goes to Bedrock. Reasoning effort (OPENAI_REASONING_EFFORT) applies to every provider.
MODEL_PROVIDER=

# Anthropic Messages API (first-party). A provider counts as configured only with credentials AND a model id.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional fast/router model (classification, summaries, routing); the primary model serves those roles when unset.
ANTHROPIC_FAST_MODEL=
# Optional: custom base URL (proxy). Leave empty for api.anthropic.com
ANTHROPIC_BASE_URL=
# Legacy extended-thinking budget (budget_tokens) for Haiku 4.5 / Sonnet 4.5 and older; 4.6+ models use adaptive thinking + effort.
ANTHROPIC_THINKING_BUDGET=0
# Default max_tokens when a caller does not set one.
ANTHROPIC_MAX_OUTPUT_TOKENS=16000
# Send tool input_examples (beta advanced-tool-use-2025-11-20). Off by default.
ANTHROPIC_TOOL_EXAMPLES=false
# Structured output mode: auto (output_config.format on 4.5+ models, forced tool call on older ones) | native | tool
ANTHROPIC_STRUCTURED_OUTPUT=auto

# Amazon Bedrock (bedrock-runtime InvokeModelWithResponseStream, SigV4-signed). Static/temporary credentials or a Bedrock API key.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Alternative to IAM keys: Bedrock API key sent as a bearer token.
AWS_BEARER_TOKEN_BEDROCK=
# Model / inference profile id, e.g. global.anthropic.claude-opus-4-6-v1 or us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL=
BEDROCK_FAST_MODEL=
# Titan (amazon.titan-embed-text-v2:0) or Cohere (cohere.embed-english-v3) embedding model; OpenAI embeddings are used when unset.
BEDROCK_EMBEDDING_MODEL=
BEDROCK_THINKING_BUDGET=0
BEDROCK_MAX_OUTPUT_TOKENS=16000
BEDROCK_STRUCTURED_OUTPUT=auto

# OpenRouter: external fast router ONLY (constitution §16). Outside the internal data boundary.
OPENROUTER_API_KEY=
OPENROUTER_ROUTER_MODEL=
OPENROUTER_HTTP_REFERER=
# Allow confidential matter data to reach the external router (default false: internal requests never leave the boundary).
ROUTER_ALLOW_MATTER_DATA=false

# Optional Skylar voice assistant. Alternatively, the signed-in workspace owner can connect a key in the mic panel.
# Master keys remain server-only. Browsers receive scoped 15-minute STT/TTS access tokens.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_STT_MODEL=ink-2
